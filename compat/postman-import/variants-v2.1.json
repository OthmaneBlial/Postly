{
  "info": {
    "name": "Postly Postman variants fixture",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.test" }
  ],
  "item": [
    {
      "name": "Structured URLs",
      "item": [
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "url": {
              "protocol": "https",
              "host": ["api", "example", "test"],
              "path": ["users", "search"],
              "query": [
                { "key": "q", "value": "Ada", "disabled": false },
                { "key": "page", "value": 2, "disabled": true }
              ]
            },
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Trace", "value": "off", "disabled": true }
            ],
            "auth": {
              "type": "apikey",
              "apikey": [
                { "key": "key", "value": "api_key" },
                { "key": "value", "value": "{{apiKey}}" },
                { "key": "in", "value": "query" }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "filter", "value": "active" },
                { "key": "ignored", "value": true, "disabled": true }
              ]
            }
          },
          "response": [
            {
              "name": "No content",
              "code": 204,
              "header": [{ "key": "X-Result", "value": "empty" }],
              "body": ""
            }
          ]
        }
      ]
    },
    {
      "name": "Upload avatar",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/avatars",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "caption", "value": "Ada", "type": "text" },
            { "key": "avatar", "type": "file", "src": "./fixtures/avatar.png" }
          ]
        }
      }
    },
    {
      "name": "GraphQL review",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/graphql",
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query Users { users { id name } }",
            "variables": "{}"
          }
        }
      },
      "event": [
        {
          "listen": "unknown",
          "script": { "type": "text/javascript", "exec": ["console.log('review');"] }
        }
      ]
    },
    {
      "name": "XML payload",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/users/42",
          "host": "api.example.test",
          "path": "users/42"
        },
        "body": {
          "mode": "raw",
          "raw": "<user><name>Ada</name></user>",
          "options": { "raw": { "language": "xml" } }
        }
      }
    },
    {
      "name": "OAuth review",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/oauth-check?scope=read",
          "query": [{ "key": "scope", "value": "read" }]
        },
        "header": [{ "key": "X-Retry", "value": 3 }],
        "auth": {
          "type": "oauth2",
          "oauth2": [
            { "key": "grant_type", "value": "authorization_code" },
            { "key": "accessToken", "value": "{{accessToken}}" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"enabled\":true}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    {
      "name": "OAuth client credentials",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/oauth-client",
        "auth": {
          "type": "oauth2",
          "oauth2": [
            { "key": "grant_type", "value": "client_credentials" },
            { "key": "accessTokenUrl", "value": "{{baseUrl}}/oauth/token" },
            { "key": "clientId", "value": "postly" },
            { "key": "clientSecret", "value": "{{clientSecret}}" },
            { "key": "scope", "value": "read:users" }
          ]
        }
      }
    },
    {
      "name": "HTML payload",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/render",
        "body": {
          "mode": "raw",
          "raw": "<main>hello</main>",
          "options": { "raw": { "language": "html" } }
        }
      }
    },
    {
      "name": "AWS signed request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/aws",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "awsv4",
          "awsv4": [
            { "key": "accessKey", "value": "AKIDEXAMPLE" },
            { "key": "secretKey", "value": "example-secret" },
            { "key": "region", "value": "us-east-1" },
            { "key": "service", "value": "execute-api" },
            { "key": "sessionToken", "value": "example-session" }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"hello\":\"world\"}",
          "options": { "raw": { "language": "json" } }
        }
      }
    }
  ]
}
